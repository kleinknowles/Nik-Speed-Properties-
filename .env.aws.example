# Copy to .env.aws on the AWS server. Never commit the filled-in file.
DOMAIN=www.example.com
WEB_ORIGIN=https://www.example.com
AWS_REGION=ap-southeast-1
DATABASE_HOST=your-lightsail-postgres-endpoint
DATABASE_PORT=5432
DATABASE_NAME=nikspeed
DATABASE_USER=dbmasteruser
DATABASE_PASSWORD=replace-with-your-database-password
JWT_KEY=replace-with-at-least-48-random-characters
S3_BUCKET=your-unique-private-bucket-name
S3_ACCESS_KEY_ID=replace-with-restricted-iam-access-key
S3_SECRET_ACCESS_KEY=replace-with-restricted-iam-secret
# Use Pesapal sandbox credentials until you intentionally enable live payments.
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_NOTIFICATION_ID=
