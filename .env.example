# Copy to .env and replace every placeholder before starting the hosted stack.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_KEY=replace-with-a-unique-random-secret-at-least-32-characters-long
WEB_ORIGIN=https://your-frontend.example.com
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=replace-with-your-pesapal-sandbox-consumer-key
PESAPAL_CONSUMER_SECRET=replace-with-your-pesapal-sandbox-consumer-secret
PESAPAL_NOTIFICATION_ID=register-the-api-ipn-url-and-put-the-returned-guid-here
PESAPAL_CALLBACK_URL=https://your-frontend.example.com/payment/complete
API_PORT=5188
# Optional: use a private S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2)
# for durable property media. Local storage uses the Docker uploads volume.
STORAGE_PROVIDER=Local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
