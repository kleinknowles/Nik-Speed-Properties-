# Copy to .env and replace every placeholder before starting the hosted stack.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_KEY=replace-with-a-unique-random-secret-at-least-32-characters-long
WEB_ORIGIN=https://your-frontend.example.com
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace-me
FLUTTERWAVE_WEBHOOK_HASH=replace-with-your-flutterwave-webhook-hash
FLUTTERWAVE_REDIRECT_URL=https://your-frontend.example.com/payment/complete
API_PORT=5188
